# Server Configuration
PORT=3001
NODE_ENV=development

# Security & CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Storage Configuration (relative or absolute path)
STORAGE_DIR=storage

# Upload Limits
MAX_FILES_PER_UPLOAD=100
MAX_FILE_SIZE_BYTES=20971520
MAX_TOTAL_SESSION_BYTES=104857600

# Session Expiry (in milliseconds: 7200000 = 2 hours)
SESSION_TTL_MS=7200000
SESSION_CLEANUP_INTERVAL_MS=900000
